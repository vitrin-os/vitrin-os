/target
**/target

# Python bytecode from the integration harness (tests/integration/) and any
# other stray interpreter runs. The sdk/ tree has its own .gitignore for this.
__pycache__/
*.pyc

# Meson build output for the C+wlroots shim (shim/, outside the Cargo workspace).
/shim/build*/
# Everything under subprojects/ is generated -- downloaded checkouts, the
# packagecache, .wraplock, and the nested wraps Meson promotes from wlroots --
# except the two wrap files we author and pin (D11).
/shim/subprojects/*
!/shim/subprojects/wlroots.wrap
!/shim/subprojects/wayland-protocols.wrap
# The pinned Firefox ESR that shim/tests/firefox/fetch-esr.sh downloads and
# checksum-verifies (P1.6.4). ~75 MB compressed, ~250 MB unpacked, and
# reproducible from shim/tests/firefox/firefox-esr.pin -- so the PIN is
# checked in and the browser never is.
/shim/.firefox/
