/* probe-catalogue.h -- GENERATED by shim/meson.build. Do not edit.
 *
 * The `--probe-globals` catalogue (P1.6.4, include/ledger.h): interfaces the
 * shim advertises WITHOUT IMPLEMENTING, so that an app's demand for one
 * becomes an observable `wl_registry.bind` instead of no wire traffic at all.
 *
 * Generated rather than hand-written for one reason: it must contain exactly
 * the interfaces whose marshalling tables this binary actually links.
 * wayland-protocols moves protocols between unstable/, staging/ and stable/
 * between releases, so meson resolves each entry against the build machine's
 * copy and drops the ones it cannot find. A hand-written list would either
 * fail to link on such a machine, or -- worse -- name an interface the
 * catalogue silently does not cover.
 */
