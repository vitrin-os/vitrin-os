@VITRIN_PROBE_ROWS@
};

static const int vitrin_probe_catalogue_len =
	(int)(sizeof(vitrin_probe_catalogue) / sizeof(vitrin_probe_catalogue[0]));

#endif /* VITRIN_PROBE_CATALOGUE_H */
